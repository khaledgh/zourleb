# --- App ---
APP_NAME=Zourleb
APP_ENV=development
APP_DEFAULT_LANG=ar
SUPER_ADMIN_EMAIL=admin@zourleb.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# --- HTTP ---
HTTP_PORT=8080
HTTP_ALLOW_ORIGINS=*

# --- Database (MySQL) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zourleb
DB_PARAMS=charset=utf8mb4&parseTime=True&loc=Local

# --- Redis (optional in dev) ---
REDIS_ENABLED=false
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- JWT ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_ISSUER=zourleb

# --- Google OAuth ---
GOOGLE_CLIENT_ID=

# --- OneSignal ---
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# --- WhatsApp OTP ---
WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE_OTP=otp_code

# --- SMS OTP ---
SMS_PROVIDER=local
SMS_FROM=Zourleb
SMS_API_KEY=
SMS_API_SECRET=

# --- Storage ---
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_PUBLIC_URL=http://localhost:8080/uploads

# --- OTP policy ---
OTP_TTL=5m
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=3
OTP_RESEND_WINDOW=60s
OTP_DAILY_CAP=10
